DATABASE_URL=postgresql://user:password@localhost:5432/database
JWT_SECRET_KEY=change-me
CUSTOMER_SYNC_BACKEND=memory
# Set a stable random secret of at least 32 bytes before selecting postgresql.
CUSTOMER_SYNC_FINGERPRINT_SECRET=
SALESFORCE_TOKEN_URL=https://example.my.salesforce.com/services/oauth2/token
SALESFORCE_CLIENT_ID=change-me
SALESFORCE_CLIENT_SECRET=change-me

# Local databases only. These do not change the application's DATABASE_URL.
LOCAL_POSTGRES_ADMIN_PASSWORD=local_admin_only
SANDBOX_DB_PASSWORD=sandbox_local_only
CUSTOMER_SYNC_TEST_PASSWORD=customer_sync_test
LOCAL_POSTGRES_TMPFS_SIZE=512m

# Sandbox HTTP API: no production fallback. Native host/port below; Compose
# overrides these two fields with local-postgres:5432 inside API containers.
SANDBOX_DATABASE_HOST=127.0.0.1
SANDBOX_DATABASE_PORT=55432
# Generate two distinct secrets, each at least 32 bytes; do not reuse production.
SANDBOX_JWT_SECRET_KEY=
SANDBOX_CUSTOMER_SYNC_FINGERPRINT_SECRET=
